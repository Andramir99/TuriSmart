# Variables de entorno del backend (plantilla).
# Copia este archivo como ".env" y ajusta los valores si hace falta.
# El archivo ".env" real NUNCA se sube a Git (ver .gitignore).

APP_ENV=development

# Dominios desde los que el navegador puede llamar a esta API, separados
# por comas. 5173 es el puerto por defecto de "npm run dev" en el frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cadena de conexión a PostgreSQL. Formato:
#   postgresql+psycopg2://usuario:contraseña@host:puerto/base_de_datos
# El rol "turismart_app" y la base "turismart_db" los crea
# backend/scripts/01_crear_base_datos.sql (Etapa 5).
DATABASE_URL=postgresql+psycopg2://turismart_app:TU_PASSWORD@localhost:5432/turismart_db
