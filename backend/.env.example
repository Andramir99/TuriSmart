# Variables de entorno del backend (plantilla).
# Copia este archivo como ".env" y ajusta los valores si hace falta.
# El archivo ".env" real NUNCA se sube a Git (ver .gitignore).

APP_ENV=development

# Dominios desde los que el navegador puede llamar a esta API, separados
# por comas. 5173 es el puerto por defecto de "npm run dev" en el frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Se completa en la Etapa 5 (conexión a PostgreSQL/PostGIS). Por ahora
# nada en el backend lee esta variable todavía.
DATABASE_URL=
