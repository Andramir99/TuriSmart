# Variables para "docker compose up" (plantilla).
# Copia este archivo como ".env" en la raíz del proyecto y completa los
# valores. Este ".env" de la raíz es solo para Docker — no confundir con
# backend/.env ni frontend/.env, que se usan al correr todo sin Docker.

# Contraseña del rol de base de datos dentro del contenedor de Postgres.
POSTGRES_PASSWORD=cambia_esta_password

# Clave para firmar los tokens de sesión (JWT). Genera la tuya con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=genera_la_tuya_con_el_comando_de_arriba

# URL pública del frontend, para que el backend la acepte en CORS.
FRONTEND_URL=http://localhost:5173

# URL pública del backend tal como la alcanza el NAVEGADOR del usuario
# (no el nombre del servicio de Docker) — Vite la "hornea" dentro del
# build, así que si cambias el puerto publicado del backend, actualiza
# esto también.
VITE_API_URL=http://localhost:8000
